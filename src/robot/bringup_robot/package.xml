<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup_robot</name>
  <version>0.1.0</version>
  <description>Launches the navigation stack with parameters and scenarios</description>
  <maintainer email="bzbear2017@gmail.com">Barry Zhang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>enav</exec_depend>
  <exec_depend>eval</exec_depend>
  <exec_depend>global_localization</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>localization</exec_depend>
  <exec_depend>mobility</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rover_description</exec_depend>
  <exec_depend>sim_sensors</exec_depend>
  <exec_depend>visual_odometry</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
