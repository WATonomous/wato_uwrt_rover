{
  "configById": {
    "3D!enav": {
      "cameraState": {
        "perspective": true,
        "distance": 25,
        "phi": 45,
        "thetaOffset": 45,
        "targetOffset": [
          0,
          0,
          0
        ],
        "target": [
          0,
          0,
          0
        ],
        "targetOrientation": [
          0,
          0,
          0,
          1
        ],
        "fovy": 45,
        "near": 0.1,
        "far": 1000
      },
      "followMode": "follow-position",
      "followTf": "base_link",
      "scene": {
        "transforms": {
          "labelSize": 0.15
        }
      },
      "transforms": {
        "frame:map": {
          "visible": true
        },
        "frame:odom": {
          "visible": true
        },
        "frame:base_link": {
          "visible": true
        },
        "frame:rocker_left": {
          "visible": false
        },
        "frame:rocker_right": {
          "visible": false
        },
        "frame:bogie_left": {
          "visible": false
        },
        "frame:bogie_right": {
          "visible": false
        },
        "frame:wheel_front_left": {
          "visible": false
        },
        "frame:wheel_middle_left": {
          "visible": false
        },
        "frame:wheel_rear_left": {
          "visible": false
        },
        "frame:wheel_front_right": {
          "visible": false
        },
        "frame:wheel_middle_right": {
          "visible": false
        },
        "frame:wheel_rear_right": {
          "visible": false
        }
      },
      "topics": {
        "/enav/height_cloud": {
          "visible": true,
          "colorField": "z",
          "colorMode": "gradient",
          "gradient": [
            "#2b2b2bff",
            "#d9d9d9ff"
          ],
          "pointSize": 3,
          "pointShape": "square"
        },
        "/enav/candidates": {
          "visible": true
        },
        "/enav/mission": {
          "visible": true
        },
        "/enav/cost": {
          "visible": true,
          "colorMode": "costmap",
          "alpha": 0.25
        },
        "/enav/cost_to_go": {
          "visible": false
        },
        "/enav/goal": {
          "visible": true,
          "pointSize": 20,
          "color": "#ff3b30ff"
        },
        "/enav/plan": {
          "visible": false
        },
        "/odom": {
          "visible": false
        }
      },
      "layers": {
        "grid": {
          "visible": true,
          "frameId": "map",
          "size": 60,
          "divisions": 12,
          "layerId": "foxglove.Grid"
        },
        "rover": {
          "visible": true,
          "label": "Rover",
          "layerId": "foxglove.Urdf",
          "sourceType": "topic",
          "topic": "/robot_description",
          "displayMode": "visual"
        }
      },
      "publish": {
        "type": "point",
        "pointTopic": "/goal_point"
      }
    },
    "Image!navcam": {
      "cameraTopic": "/navcam/image_viz/compressed",
      "imageMode": {
        "imageTopic": "/navcam/image_viz/compressed"
      }
    },
    "Plot!localization": {
      "title": "Localization error vs ground truth (m)",
      "paths": [
        {
          "value": "/eval/stats.position_error",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "estimate (odometry + orbital fixes)"
        },
        {
          "value": "/eval/stats.odom_position_error",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "odometry only"
        }
      ],
      "showLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp"
    },
    "Plot!mobility": {
      "title": "Slip and planning",
      "paths": [
        {
          "value": "/localization/slip.slip",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "slip"
        },
        {
          "value": "/enav/plan.ace_evaluations",
          "enabled": false,
          "timestampMethod": "receiveTime",
          "label": "ACE paths checked"
        },
        {
          "value": "/enav/plan.planning_time_ms",
          "enabled": false,
          "timestampMethod": "receiveTime",
          "label": "planning ms"
        }
      ],
      "showLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp"
    },
    "RawMessages!mobility": {
      "topicPath": "/mobility/status"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "direction": "row",
    "first": "3D!enav",
    "second": {
      "direction": "column",
      "first": "Image!navcam",
      "second": {
        "direction": "column",
        "first": {
          "direction": "row",
          "first": "Plot!localization",
          "second": "Plot!mobility"
        },
        "second": "RawMessages!mobility",
        "splitPercentage": 70
      },
      "splitPercentage": 40
    },
    "splitPercentage": 60
  }
}
